APP_ENV=development
PORT=8080
PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional for liveness. Local PostgreSQL setup is documented in README.md.
# Development-only example for the local Docker container on host port 5433.
# DATABASE_URL=postgresql+psycopg://guardian:guardian-local@127.0.0.1:5433/guardian
# Cloud deployment injects a separate connection through Secret Manager.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Configure these when implementing the evidence/provider milestone.
# EVIDENCE_BUCKET=replace-with-private-bucket
# AI_PROVIDER=replace-with-implemented-provider
# AI_MODEL=replace-with-tested-model
# AI_API_KEY=replace-with-runtime-secret
AI_TIMEOUT_SECONDS=20
HOLD_TTL_SECONDS=900
DRAFT_TTL_SECONDS=1800
ASSESSMENT_TTL_SECONDS=300
AI_SANDBOX_HOURLY_LIMIT=20
GROUP_SANDBOX_HOURLY_LIMIT=5
AI_DAILY_GLOBAL_LIMIT=300
